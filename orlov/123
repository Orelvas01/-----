def show_asymmetry(self):
        if self.mk_values is None:
            self.output_text.insert(tk.END, "Сначала рассчитайте МК.\n")
            return
        
        try:
            mk_mean = np.nanmean(self.mk_values, axis=0)
            mk_max_all = np.nanmax(mk_mean)
            mk_min_all = np.nanmin(mk_mean)
            asymmetry = ((mk_max_all - mk_min_all) / ((mk_max_all + mk_min_all) / 2)) * 100

            self.output_text.insert(tk.END, f"Несимметричность МК, %: {asymmetry:.3f}\n")
        except Exception as e:
            self.output_text.insert(tk.END, f"Ошибка при расчёте несимметричности: {e}\n")
